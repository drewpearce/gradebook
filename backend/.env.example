# Copy to .env for local development. Matches the docker-compose Postgres service.
DATABASE_URL=postgresql+psycopg://gradebook:gradebook@localhost:5432/gradebook

# Set to "production" in real deployments — this makes the app refuse to boot unless
# SECRET_KEY and DATABASE_URL are overridden with real values.
ENVIRONMENT=dev

# Auth — generate a real secret in production, e.g. `python -c "import secrets; print(secrets.token_urlsafe(32))"`
SECRET_KEY=dev-insecure-secret-change-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=720

# Directory of the built SPA to serve at "/" (leave unset for API-only / Vite dev).
# STATIC_DIR=../frontend/dist

# Set to true only behind Fly's proxy: client IP for login rate limiting comes from Fly-Client-IP.
# TRUST_PROXY_IP_HEADER=false
