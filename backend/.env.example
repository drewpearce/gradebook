# Copy to .env for local development. Matches the docker-compose Postgres service.
DATABASE_URL=postgresql+psycopg://gradebook:gradebook@localhost:5432/gradebook

# Auth — generate a real secret in production, e.g. `python -c "import secrets; print(secrets.token_urlsafe(32))"`
SECRET_KEY=dev-insecure-secret-change-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=720

# Origins allowed to call the API cross-origin (the Vite SPA in dev). JSON array.
CORS_ORIGINS=["http://localhost:5173"]
